<Layouts.app flash={@flash}>
  <div class="play-page mx-auto max-w-6xl px-4 py-8">
    <%!-- the identity form stays in the DOM (it drives the server-side
         resolve/attach). While a game is running it is hidden on EVERY
         screen — the game surface stands alone; on the terminal state
         (finished/interrupted) it re-surfaces as the restart card, and
         with no game focused it is the claim screen (a centered
         title-screen card on touch devices) --%>
    <div class={
      cond do
        @focused_name != nil and not game_over?(@game_status) -> "hidden"
        true -> "max-lg:mx-auto max-lg:mt-6 max-lg:max-w-sm"
      end
    }>
      <.identity_form
        form={@form}
        mode={@mode}
        access_string={@access_string}
        notice={@notice}
        input_prefix="play"
        start_label={if @focused_name != nil, do: "Play again", else: "Start game"}
      />
    </div>

    <section id="play-section" class="mt-8">
      <div class="mb-3 hidden flex-wrap items-center justify-between gap-2 lg:flex">
        <h2 class="text-lg font-semibold text-base-content">Play</h2>
        <.compact class="hidden lg:inline-flex" />
      </div>
      <div class="mt-3">
        <%= if @focused_name do %>
          <div id="play-keys" phx-hook="AlaypzKeys" data-mobile-game>
            <.live_component
              module={FocusedGame}
              id={:focused}
              name={@focused_name}
              show_unfocus={false}
              fit_height
            />
          </div>

          <%!-- the board IS the touch surface: swipe to move, flick down
               to hard-drop, flick up to rotate, press-and-hold to hold
               (the .AlaypzKeys hook). Desktop keeps the kbd legend
               inside the surface. --%>
          <p
            id="swipe-hint"
            class="mt-3 text-center text-[11px] font-medium tracking-wide text-base-content/40 max-lg:mt-4"
          >
            swipe to move · flick down to drop · flick up to rotate · press &amp; hold to hold
          </p>
        <% else %>
          <%!-- mobile: the form above is the whole claim screen; the
               empty-state box is desktop-only filler --%>
          <div class="hidden rounded-xl border border-dashed border-base-300 p-5 text-sm text-base-content/60 lg:block">
            Claim a name and start a game to play here.
          </div>
        <% end %>
      </div>
    </section>
  </div>
</Layouts.app>
