<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <%!-- name form + one-time access string --%>
    <section id="identity" class="rounded-xl border border-base-300/60 bg-base-100 p-4 shadow-sm">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
        <h1 class="text-lg font-bold text-base-content">Claim your name</h1>
        <span class="text-xs text-base-content/60">
          your name is stored in this browser — the access string reclaims it elsewhere
        </span>
      </div>

      <.form for={@form} id="name-form" phx-change="validate" phx-submit="submit">
        <div class="flex flex-wrap items-center gap-2">
          <.input
            field={@form[:name]}
            type="text"
            placeholder="Your name"
            id="lobby-name"
            class="w-56 input text-base"
            phx-hook=".LocalName"
          />

          <%= if @mode == :reclaim do %>
            <.input
              field={@form[:access]}
              type="text"
              placeholder="Access string"
              id="lobby-access"
              class="w-64 input text-base"
            />
          <% end %>

          <button
            type="submit"
            id="claim-button"
            class="rounded-lg bg-cyan-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-cyan-500"
          >
            {if @mode == :reclaim, do: "Reclaim name", else: "Claim name"}
          </button>

          <button
            type="button"
            id="start-button"
            phx-click="start"
            phx-value-name={@form[:name].value || ""}
            class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-500 disabled:cursor-not-allowed disabled:opacity-40"
            disabled={@form[:name].value in [nil, ""]}
          >
            Start game
          </button>
        </div>

        <%= for {field, {message, _opts}} <- @form.errors do %>
          <p id={"form-error-#{field}"} class="mt-2 text-sm text-rose-400">{message}</p>
        <% end %>
      </.form>

      <%= if @access_string do %>
        <div
          id="access-string"
          class="mt-3 rounded-lg border border-amber-500/40 bg-amber-500/10 p-3"
        >
          <p class="text-sm font-semibold text-amber-600 dark:text-amber-300">
            Access string — shown only once. Keep it to reclaim this name later:
          </p>
          <p id="access-string-value" class="mt-1 text-lg font-semibold tracking-widest text-amber-600 dark:text-amber-200">
            {@access_string}
          </p>
        </div>
      <% end %>

      <%= if @notice do %>
        <p id="lobby-notice" class="mt-3 text-sm text-base-content/80">{@notice}</p>
      <% end %>
    </section>

    <%!-- live game cards: every ongoing game renders its own live board --%>
    <section id="games" class="mt-8">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-base-content">Live games</h2>
        <span class="text-xs text-base-content/60">click a card to take control</span>
      </div>
      <div id="game-cards" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <%= if @cards == [] do %>
          <div class="col-span-full rounded-xl border border-dashed border-base-300 p-4 text-sm text-base-content/60">
            No games yet — claim a name and press Start.
          </div>
        <% end %>
        <%= for name <- @cards do %>
          <.live_component
            module={GameCard}
            id={name}
            name={name}
            focused={name == @focused_name}
          />
        <% end %>
      </div>
    </section>

    <%!-- the focused session (.AlaypzCanvas hook renders the pushed frames) --%>
    <section id="focused-section" class="mt-8">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-base-content">Session</h2>
        <.compact class="hidden md:inline-flex" />
      </div>
      <div class="mt-3">
        <%= if @focused_name do %>
          <%!-- the .AlaypzKeys hook only mounts for the view's own game:
               spectators get the live board but no key handling --%>
          <%= if @form[:name].value && String.downcase(@focused_name) == String.downcase(@form[:name].value) do %>
            <div id="focused-keys" phx-hook="AlaypzKeys">
              <.live_component module={FocusedGame} id={:focused} name={@focused_name} />
            </div>
          <% else %>
            <div id="focused-keys">
              <.live_component
                module={FocusedGame}
                id={:focused}
                name={@focused_name}
                spectating={true}
              />
            </div>
          <% end %>
        <% else %>
          <div class="rounded-xl border border-dashed border-base-300 p-5 text-sm text-base-content/60">
            Start a game or click a card to focus it here.
          </div>
        <% end %>
      </div>
    </section>

    <%!-- recent results --%>
    <section id="recent-results" class="mt-8">
      <h2 class="text-lg font-semibold text-base-content">Recent results</h2>
      <div class="mt-3">
        <%= if @results == [] do %>
          <p class="rounded-xl border border-dashed border-base-300 p-4 text-sm text-base-content/60">
            No finished games yet.
          </p>
        <% else %>
          <table class="w-full text-sm">
            <thead class="text-left text-base-content/60">
              <tr>
                <th class="py-1 pr-4">name</th>
                <th class="py-1 pr-4">score</th>
                <th class="py-1 pr-4">lines</th>
                <th class="py-1 pr-4">level</th>
                <th class="py-1">ended</th>
              </tr>
            </thead>
            <tbody class="text-base-content/80">
              <%= for score <- @results do %>
                <tr id={"result-#{score.id}"} class="border-t border-base-300/60">
                  <td class="py-1 pr-4">
                    <.link
                      navigate={"/#{score.player.name}"}
                      class="text-base-content transition hover:text-cyan-500"
                    >
                      {score.player.name}
                    </.link>
                  </td>
                  <td class="py-1 pr-4 text-cyan-600 dark:text-cyan-300">{score.score}</td>
                  <td class="py-1 pr-4">{score.lines}</td>
                  <td class="py-1 pr-4">{score.level}</td>
                  <td class="py-1">{score.end_reason}</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </section>
  </div>
</Layouts.app>

<script :type={Phoenix.LiveView.ColocatedHook} name=".LocalName">
  export default {
    mounted() {
      const saved = localStorage.getItem("alaypz_name");
      if (saved) {
        this.el.value = saved;
        this.el.dispatchEvent(new Event("input", { bubbles: true }));
      }

      this.el.addEventListener("change", () => {
        if (this.el.value) {
          localStorage.setItem("alaypz_name", this.el.value);
        }
      });
    }
  };
</script>
