<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <%!-- hero: the experiment title (display text — the claim form keeps
         the page's single h1) + the two prose pages --%>
    <div id="lobby-hero" class="mb-8">
      <div class="text-center text-3xl font-black tracking-tight sm:text-4xl">
        A local AI experiment with Qwen3.8-27B
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <.link
          navigate="/why"
          class="rounded-xl border border-base-300/80 bg-base-200/40 px-5 py-3 text-center font-semibold transition hover:border-cyan-400/60 hover:text-cyan-500"
        >
          Why does this exist?
        </.link>
        <.link
          navigate="/the-case-for-and-against-local-ai"
          class="rounded-xl bg-cyan-400 px-5 py-3 text-center font-semibold text-cyan-950 shadow-lg shadow-cyan-500/30 transition hover:bg-cyan-300"
        >
          The case for and against local AI
        </.link>
      </div>
    </div>

    <%!-- name form + one-time access string; the Play button goes to /play --%>
    <.identity_form
      form={@form}
      mode={@mode}
      access_string={@access_string}
      notice={@notice}
      input_prefix="lobby"
      start_label="Play"
    />

    <%!-- live game cards: every ongoing game renders its own live board --%>
    <section id="games" class="mt-8">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-base-content">Live games</h2>
        <span class="text-xs text-base-content/60">click a card to watch it here</span>
      </div>
      <div id="game-cards" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <%= if @cards == [] do %>
          <div class="col-span-full rounded-xl border border-dashed border-base-300 p-4 text-sm text-base-content/60">
            No games yet — claim a name and press Play.
          </div>
        <% end %>
        <%= for name <- @cards do %>
          <.live_component
            module={GameCard}
            id={name}
            name={name}
            focused={name == @focused_name}
          />
        <% end %>
      </div>
    </section>

    <%!-- the focused session: a spectating surface (other players' games).
         The .AlaypzCanvas hook renders the pushed frames; the owner's own
         game is played on /play, not here. --%>
    <section id="focused-section" class="mt-8">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-base-content">Session</h2>
        <.compact class="hidden md:inline-flex" />
      </div>
      <div class="mt-3">
        <%= if @focused_name do %>
          <div id="focused-keys">
            <.live_component
              module={FocusedGame}
              id={:focused}
              name={@focused_name}
              spectating={true}
            />
          </div>
        <% else %>
          <div class="rounded-xl border border-dashed border-base-300 p-5 text-sm text-base-content/60">
            Start a game or click a card to focus it here.
          </div>
        <% end %>
      </div>
    </section>

    <%!-- top results: score desc — click a card for the full session --%>
    <section id="recent-results" class="mt-8">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-base-content">Top scores</h2>
        <span class="text-xs text-base-content/60">click a card for the full session</span>
      </div>

      <%= if @results == [] do %>
        <p class="rounded-xl border border-dashed border-base-300 p-4 text-sm text-base-content/60">
          No finished games yet.
        </p>
      <% else %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <%= for {score, rank} <- Enum.with_index(@results, 1) do %>
            <.score_card
              score={score}
              rank={rank}
              board_id={"result-board-#{score.id}"}
              id={"result-#{score.id}"}
              phx-click="open-session"
              phx-value-id={score.id}
            />
          <% end %>
        </div>
      <% end %>
    </section>
  </div>

  <%= if @session do %>
    <.session_drawer session={@session} rank={if @session_rank, do: @session_rank + 1} />
  <% end %>
</Layouts.app>
