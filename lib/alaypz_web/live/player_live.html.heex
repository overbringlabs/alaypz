<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <header class="mb-6">
      <h1
        id="player-title"
        class="font-display text-2xl font-bold tracking-tight"
      >
        <span class="text-cyan-600 dark:text-cyan-300">{@name}</span>&nbsp;· games
      </h1>
      <p class="mt-1 text-sm text-base-content/60">
        finished and interrupted games, newest first
      </p>
    </header>

    <%= if @player == nil do %>
      <div
        id="player-not-found"
        class="rounded-xl border border-dashed border-base-300 p-6 text-sm text-base-content/60"
      >
        No player named <span class="text-base-content">{@name}</span>.
        <.link navigate="/" class="text-cyan-600 transition hover:text-cyan-500">
          Claim the name in the lobby
        </.link>
        to keep a game under it.
      </div>
    <% else %>
      <%= if @results == [] do %>
        <div
          id="player-no-games"
          class="rounded-xl border border-dashed border-base-300 p-6 text-sm text-base-content/60"
        >
          No finished games yet.
        </div>
      <% else %>
        <div id="player-scores" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <%= for score <- @results do %>
            <.score_card
              score={score}
              board_id={"ps-board-#{score.id}"}
              id={"ps-#{score.id}"}
              clickable={false}
            />
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</Layouts.app>
