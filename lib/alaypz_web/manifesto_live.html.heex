<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <%!-- hero image: the local hardware this runs on --%>
    <img
      src="/images/molon-lave-gpu.webp"
      alt="the local GPU hardware this runs on"
      class="mb-6 w-full rounded-xl border border-base-300/60"
    />
    <h1
      id="manifesto-title"
      class="font-display mb-3 text-2xl font-black tracking-tight lg:text-3xl"
    >
      The case for and against local, personal AI
    </h1>
    <p id="case-byline" class="mb-6 text-sm text-base-content/60">
      <a
        href="https://overbring.com/about/"
        target="_blank"
        rel="noopener"
        class="underline decoration-base-300 underline-offset-2 transition hover:text-cyan-500"
      >
        Isaak Tsalicoglou
      </a>
      · 2026-11-09
    </p>
    <div class="history-prose">
      {MDEx.to_heex!(AlaypzWeb.Markdown.document("manifesto.md"))}
    </div>
  </div>
</Layouts.app>
