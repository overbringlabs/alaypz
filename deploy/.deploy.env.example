# Target of deploy/deploy.sh. Copy to the repo root as `.deploy.env`
# (gitignored) and fill in — or export the same variables in the
# environment. deploy.sh refuses to run without all three set.
#
# First run on the deploy host (as the deploy user):
#   ssh "$DEPLOY_HOST" 'install -d "$DATA_HOST_DIR" && $EDITOR "$ENV_HOST_FILE"'

# ssh target (user@host)
DEPLOY_HOST=user@example-host
# Remote data dir — bind-mounted to /app/data (the SQLite file lives here)
DATA_HOST_DIR=~/apps_data/alaypz
# Remote env file — SECRET_KEY_BASE + PHX_HOST (see alaypz.env.example,
# chmod 600, never committed)
ENV_HOST_FILE=~/alaypz.env
