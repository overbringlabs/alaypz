# Copy to DEPLOY_HOST:~/alaypz.env (chmod 600, NOT committed) and fill in the
# secret. deploy/deploy.sh passes PORT and DATABASE_PATH itself; the app
# refuses to start in prod without SECRET_KEY_BASE (config/runtime.exs).

# Phoenix cookie/signing secret. Generate: mix phx.gen.secret
SECRET_KEY_BASE=

# Public host used in URL generation. Caddy on DEPLOY_HOST reverse-proxies
# https://alaypz.overbring.com to 127.0.0.1:7043 (Caddyfile.snippet).
# No path prefix — the app is mounted at root on this host.
PHX_HOST=alaypz.overbring.com

# Optional overrides (defaults live in config/runtime.exs; deploy.sh sets
# PORT=7043 and DATABASE_PATH itself):
# POOL_SIZE=5
